# Ignore downloaded ID files
ids/*.ids
wireless-regdb/regulatory.db*

# Local-only proprietary blobs: MUST NEVER reach GitHub.
# Restored locally via download scripts / manual copy (see download_*.sh).
firmware/
installer/tools/
prebuilt/

# GRUB core image: a packed binary image, not source. Rebuilt locally with
# grub-mkimage from the .mod files next to it, so it does not belong in git.
installer/grub/bios/core.img
installer/grub/efi/BOOTX64.EFI
